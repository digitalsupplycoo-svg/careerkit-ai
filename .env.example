# Copy this file to .env.local and fill in real values.
# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty until you have a real AdSense publisher ID.
# NEVER commit .env.local or real IDs to a public repository.

# Copy this file to .env.local and fill in real values.
# Leave NEXT_PUBLIC_ADSENSE_CLIENT empty until you have a real AdSense publisher ID.
# NEVER commit .env.local or real IDs to a public repository.

# Set this once AdSense issues your ca-pub-... ID (available at account creation,
# not gated on site approval) — e.g. when AdSense asks you to place the
# verification snippet. This loads the AdSense script/verification tag and
# powers /ads.txt, but by itself does NOT show any visible ad units.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Only set this to "true" AFTER Google has actually approved the site.
# This is what turns on visible ad unit boxes (AdSlot). Keep it unset/false
# during verification and review, even with a real client ID configured above.
NEXT_PUBLIC_ADSENSE_ENABLE_UNITS=

NEXT_PUBLIC_ADSENSE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://www.careerkit.example
NEXT_PUBLIC_CONTACT_EMAIL=contact@careerkit.example
