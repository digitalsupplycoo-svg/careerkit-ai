# Copy this file to .env.local and fill in real values.
# The existing public publisher ID is the code fallback; set this only to override it.
# NEVER commit .env.local or real IDs to a public repository.

# Optional override for the existing public ca-pub ID. This powers the
# verification script and /ads.txt but does NOT show visible ad units by itself.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Only set this to "true" AFTER Google has actually approved the site.
# This is what turns on visible ad unit boxes (AdSlot). Keep it unset/false
# during verification and review, even with a real client ID configured above.
NEXT_PUBLIC_ADSENSE_ENABLE_UNITS=

NEXT_PUBLIC_ADSENSE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://www.careerkit.online
NEXT_PUBLIC_CONTACT_EMAIL=info@careerkit.online
