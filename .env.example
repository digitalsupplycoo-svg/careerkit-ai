# Copy this file to .env.local and fill in real values.
# The existing public publisher ID (lib/env.ts) is already the code fallback,
# so this only needs a value here if you want to override it — e.g. for a
# fork, a staging environment, or if Google ever issues a different ID.
# NEVER commit .env.local or real IDs/tokens/passwords to a public repository.

# Optional override for the existing public ca-pub ID. This powers the
# verification script and /ads.txt but does NOT show visible ad units by itself.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Only set this to "true" AFTER Google has actually approved the site.
# This is what turns on visible ad unit boxes (AdSlot). Keep it unset/false
# during verification and review, even with a real client ID configured above.
NEXT_PUBLIC_ADSENSE_ENABLE_UNITS=

NEXT_PUBLIC_ADSENSE_VERIFICATION=
NEXT_PUBLIC_SITE_URL=https://www.careerkit.online
NEXT_PUBLIC_CONTACT_EMAIL=info@careerkit.online

# ---- Admin: /admin/new-post (see PUBLISHING.md) ----
# None of the four vars below are NEXT_PUBLIC_-prefixed on purpose — Next.js
# never bundles unprefixed vars into client-side JS, so these stay
# server-only no matter what.

# The login password for /admin. Pick something long and unique to this
# site — it's also used as the signing key for the session cookie, not just
# compared against on login.
ADMIN_PASSWORD=

# A GitHub fine-grained personal access token, SCOPED TO THIS ONE REPOSITORY
# ONLY, with "Contents: Read and write" repository permission and nothing
# else. Do not use a classic PAT or an org-wide/all-repos fine-grained token
# here — if this value ever leaks, its blast radius should be "someone can
# write files to this one repo's content," not "someone has broad access to
# your GitHub account." See PUBLISHING.md for exact setup and rotation steps.
GITHUB_TOKEN=

# Your GitHub username (the repo owner).
GITHUB_OWNER=

# The repository name the New Post form commits articles into.
GITHUB_REPO=careerkit-ai
